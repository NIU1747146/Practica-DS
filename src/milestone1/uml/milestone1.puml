@startuml
'https://plantuml.com/class-diagram
skinparam classAttributeIconSize 0

class Main {
+ {static} main(args : String[])
}
note right of Main::main
DirectoryDoors.getInstance().makeDoors()
DirectoryAreas.getInstance().makeAreas()
DirectoryUsers.getInstance().makeUsers()
new WebServer()
end note

class WebServer {
- {static} PORT : int
- {static} formatter : DateTimeFormatter
+ WebServer()
}

class SocketThread {
- insocked : Socket
- makeRequest(tokens : String[]) : Request
- makeRequestReader(tokens : String[]) : RequestReader
- makeRequestArea(tokens : String[]) : RequestArea
- makeHeaderAnswer() : String
- makeJsonAnswer(request : Request) : String
+ run()
}
WebServer +-right- SocketThread
note bottom of SocketThread
inner class
of WebServer
end note

class DirectoryDoors {
- {static} instance : DirectoryDoors
- allDoors : Door[]
- DirectoryDoors()
+ {static} getInstance() : DirectoryDoors
+ makeDoors()
+ findDoorById(id : String) : Door
+ getAllDoors() : Door[]
}

class DirectoryAreas {
- {static} instance : DirectoryAreas
- rootArea : Area
- DirectoryAreas()
+ {static} getInstance() : DirectoryAreas
+ makeAreas()
+ findAreaById(id : String) : Area
- link(doorId : String, from : Space, to : Space)
}

class DirectoryUsers {
- {static} instance : DirectoryUsers
- users : User[]
- DirectoryUsers()
+ {static} getInstance() : DirectoryUsers
+ makeUsers()
+ findUserByCredential(credential : String) : User
}

abstract class Area {
# id : String
+ getId() : String
+ {abstract} accept(visitor : Visitor)
}

class Partition {
- children : Area[]
+ addChild(child : Area)
+ accept(visitor : Visitor)
}

class Space {
- doorsGivingAccess : Door[]
+ addDoorGivingAccess(door : Door)
+ getDoorsGivingAccess() : Door[]
+ accept(visitor : Visitor)
}

note "Composite pattern" as NComposite
NComposite .. Partition

class Door {
- id : String
- closed : boolean
+ Door(id : String)
+ processRequest(request : RequestReader)
- doAction(action : String)
+ setState(state : DoorState)
+ setSpaces(origin : Space, destination : Space)
+ getOriginSpace() : Space
+ getDestinationSpace() : Space
+ isClosed() : boolean
+ setClosed(closed : boolean)
+ getStateName() : String
+ toJson() : JSONObject
}

class User {
- name : String
- credential : String
+ User(name : String, credential : String)
+ setGroup(group : UserGroup)
+ canSendRequest(now : LocalDateTime) : boolean
+ canAccessSpace(space : Space) : boolean
+ canDoAction(action : String) : boolean
}

class UserGroup {
- name : String
- actions : String[]
+ UserGroup(name, schedule, actions, areas, users)
+ isWithinSchedule(dateTime : LocalDateTime) : boolean
+ hasAction(action : String) : boolean
+ hasSpace(space : Space) : boolean
+ findUserByCredentials(credential : String) : User
}

class Schedule {
- fromDate : LocalDate
- toDate : LocalDate
- daysOfWeek : DayOfWeek[]
- fromHour : LocalTime
- toHour : LocalTime
+ isWithin(dateTime : LocalDateTime) : boolean
}

class Actions {
+ {static} LOCK : String
+ {static} UNLOCK : String
+ {static} UNLOCK_SHORTLY : String
+ {static} OPEN : String
+ {static} CLOSE : String
}

package doorstates {
  abstract class DoorState
}

package requests {
  class RequestReader
}

package milestone2 {
  interface Visitor
}

Area <|-- Partition
Area <|-- Space
Partition o--> "*" Area : children
Space --> "*" Door : doorsGivingAccess
Door --> "1" Space : originSpace
Door --> "1" Space : destinationSpace
Door --> "1" DoorState : doorState
Door ..> RequestReader : processes

DirectoryDoors --> "*" Door : allDoors
DirectoryAreas --> "1" Area : rootArea
DirectoryUsers --> "*" User : users
DirectoryDoors --> "1" DirectoryDoors : instance
DirectoryAreas --> "1" DirectoryAreas : instance
DirectoryUsers --> "1" DirectoryUsers : instance
note "Singleton pattern" as NSingleton
NSingleton .. DirectoryAreas

User --> "1" UserGroup : group
UserGroup --> "*" User : users
UserGroup --> "*" Area : areas
UserGroup --> "1" Schedule : schedule

Area ..> Visitor : accept
note "Visitor pattern" as NVisitor
NVisitor .. Visitor

Main -[hidden]down- WebServer
@enduml
