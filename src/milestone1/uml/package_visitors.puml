@startuml
'https://plantuml.com/state-diagram
skinparam classAttributeIconSize 0

package milestone2 {
  interface Visitor {
  + {abstract} visitSpace(space : Space)
  + {abstract} visitPartition(partition : Partition)
  }

  class DoorsGivingAccessVisitor implements Visitor {
  - doors : Door[]
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  + getDoors() : Door[]
  }

  class SpacesVisitor implements Visitor {
  - spaces : Space[]
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  + getSpaces() : Space[]
  }

  class FindAreaByIdVisitor implements Visitor {
  - id : String
  - resultArea : Area
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  + getResultArea() : Area
  }
}

class Space
class Partition
class Area
class Door

Visitor ..> Space : visits
Visitor ..> Partition : visits
FindAreaByIdVisitor --> "0..1" Area : resultArea
DoorsGivingAccessVisitor --> "*" Door : doors
SpacesVisitor --> "*" Space : spaces
@enduml
